--- /dev/null
+++ b/src/services/festivalNamedRow.ts
@@ -0,0 +1,12 @@
+/** Keep a literal festival prefix that the evidence model abbreviated away.
+ * No year, clock, venue, author or document text is generated here. */
+export function literalNamedFestivalActivity(a:{eventText:string;activityRowText?:string;festivalNameText:string},editionName:string):string|undefined {
+ const key=(v:string)=>v.toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
+ const row=a.activityRowText||'',name=a.festivalNameText,title=a.eventText;
+ if(!row||!name||!title||key(name)!==key(editionName)||!/\b(?:fest|festival)\b/i.test(name))return;
+ const start=row.indexOf(name),end=row.indexOf(title,start+name.length);
+ if(start<0||end<0||row.indexOf(name,start+name.length)>=0||row.indexOf(title,end+title.length)>=0)return;
+ if(!/^[\s:—–-]+$/.test(row.slice(start+name.length,end)))return;
+ const literal=row.slice(start,end+title.length);
+ return key(literal).startsWith(key(editionName)+' ')?literal:undefined;
+}
