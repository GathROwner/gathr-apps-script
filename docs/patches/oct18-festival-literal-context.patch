+++ b/src/services/festivalNamedRow.test.ts
@@ -0,0 +1,23 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import fixtures from './oct18FestivalFixtures.json';
+import {literalNamedFestivalActivity} from './festivalNamedRow.js';
+import {literalFestivalProgrammeHeading} from './festivalProgrammeHeading.js';
+test('actual shortened roundup titles retain their literal ANCHOR prefix',()=>{
+ const roundup=fixtures.find(r=>r.activities.some(a=>a.kind==='festival_activity'))!;
+ assert.equal(roundup.activities.length,7);
+ for(const a of roundup.activities){const text=literalNamedFestivalActivity(a,'Anchor Fest');assert(text);assert(a.activityRowText!.includes(text));assert(text.includes(a.eventText));
+  assert.equal(literalNamedFestivalActivity({...a,activityRowText:a.eventText},'Anchor Fest'),undefined);
+  assert.equal(literalNamedFestivalActivity(a,'Different Festival'),undefined);
+  assert.equal(literalNamedFestivalActivity({...a,activityRowText:a.activityRowText+'\n'+a.activityRowText},'Anchor Fest'),undefined);
+ }
+});
+test('same-image day heading and immediately printed year bind; other image/year/section does not',()=>{
+ const programme:any=fixtures.find(r=>r.activities.some(a=>a.kind==='programme_row'))!;
+ const a=programme.activities.find((a:any)=>a.sourceScope?.documentIndex===1)!;
+ const input={documents:programme.documents,scope:a.sourceScope,festivalNameText:a.festivalNameText,yearText:a.yearText};
+ const h=literalFestivalProgrammeHeading(input);assert(h);assert(h.includes('2026'));assert(h.includes(a.festivalNameText));
+ assert.equal(literalFestivalProgrammeHeading({...input,yearText:'2025'}),undefined);
+ assert.equal(literalFestivalProgrammeHeading({...input,scope:{...input.scope!,documentIndex:0}}),undefined);
+ const documents=programme.documents.map((d:any)=>d.index===1?{...d,text:d.text.replace('ANCHOR\nFEST\nDAY 4','Another Festival\nDAY 4')}:d);
+ assert.equal(literalFestivalProgrammeHeading({...input,documents}),undefined);
+});
