+import type {FestivalReviewedCorroboration} from './festivalReviewedCorroboration.js';
+const sha=(s:string)=>createHash('sha256').update(s).digest('hex');
+function fixture():Parameters<typeof reviewedFestivalCorroboration>[0] {
+ const edition={id:'festival_fixture',name:'Harvest Fest',year:2026,startDate:'2026-10-17',endDate:'2026-10-17',organizerId:'reviewed',organizerNames:['Harvest Fest'],sourceIds:['https://official.example/harvest']};
+ const source={id:'e_fixture',source:{id:'123456789',url:'https://social.example/post',text:'Harvest Fest Saturday October 17\nPHOTO BOOTH\n3-7 PM',publisherId:'publisher_fixture'},kind:'festival_activity' as const,scopeText:'PHOTO BOOTH\n3-7 PM',membershipText:'Harvest Fest',festivalNameText:'Harvest Fest',yearText:'',activity:{name:'Photo Booth',venueId:'venue_fixture',startDate:'',startTime:'15:00'},eventText:'PHOTO BOOTH',dateText:'Saturday October 17',timeText:'3-7 PM',venueText:'Venue'};
+ const context={captureKey:'capture_fixture',sourceFingerprint:sha('caption+ordered gallery'),evidencePolicy:'unchanged',activityFingerprint:sha('original captured activity'),verifierAccepted:true};
+ const version={seconds:100,nanoseconds:15};
+ const canonical={path:'venues/venue_fixture/events/child_fixture',version,data:{eventName:'Photo Booth',venueId:'venue_fixture',startDate:'2026-10-17',endDate:'2026-10-17',startTime:'15:00',endTime:'19:00',isRecurring:'No'}};
+ const programmeData={linkedEventIds:['child_fixture'],sourceUrl:'https://official.example/harvest'};
+ const umbrella={path:'venues/venue_fixture/events/festival_fixture',version,data:{eventName:'Harvest Fest',venueId:'venue_fixture',startDate:'2026-10-17',endDate:'2026-10-17',startTime:'15:00',endTime:'20:00',programmeData}};
+ const review={path:'festival_programme_reviews/review_fixture',version,data:{status:'published',finalization:{manual:{programmeData}},programmeEventLinks:[{eventPath:canonical.path,eventName:'Photo Booth',startDate:'2026-10-17',startTime:'15:00',sourceUrl:programmeData.sourceUrl}],heldItems:[{name:'Outdoor Play Zone'}]}};
+ const header='Harvest Fest at Venue Saturday, October 17, 2026 | 3:00 to 8:00 pm';
+ const row='Photo Booth | 3:00 to 7:00 pm',body=header+' '+row;
+ const site={path:'festival_website_evidence/festival_fixture',version,data:{version:1,editionId:edition.id,url:programmeData.sourceUrl,body,bodySha256:sha(body),httpBody:body,httpBodySha256:sha(body),observedAt:'2026-10-17T12:00:00Z'}};
+ const receipt:FestivalReviewedCorroboration={version:1,kind:'reviewed_existing_member',reviewId:'review_receipt_fixture',reviewedAt:'2026-10-17T13:00:00Z',editionId:edition.id,editionFingerprint:fp(edition),sourceId:source.source.id,sourceVenueText:source.venueText,...context,evidenceId:source.id,evidenceFingerprint:fp(source),review:{path:review.path,version,fingerprint:fp(review.data)},umbrella:{path:umbrella.path,version,fingerprint:fp(umbrella.data)},website:{path:site.path,url:site.data.url,bodySha256:sha(body),httpBodySha256:sha(body),venueText:'Venue',header:{start:0,end:header.length,text:header,dateText:'October 17, 2026',date:'2026-10-17',year:2026},rows:[{start:header.length+1,end:body.length,text:row,name:'Photo Booth',startTime:'15:00',endTime:'19:00'}]},rowIndex:0,canonical:{path:canonical.path,version,fingerprint:fp(canonical.data),name:'Photo Booth',venueId:'venue_fixture',date:'2026-10-17',startTime:'15:00',endTime:'19:00'}};
+ return {edition,source,context,receipts:[receipt],websites:[site],umbrella,review,candidates:[canonical],suppressedEventIds:[],asOf:'2026-10-17'};
+}
+test('acknowledges only an exact existing manual member; leaves source literals and ownership blank',()=>{
+ const f=fixture(),before=structuredClone(f),out=reviewedFestivalCorroboration(f)!;
+ assert.equal(out.status,'corroborated');assert.equal(out.reason,'reviewed_existing_member');assert.equal(out.supplementalEvidence?.originalEvidenceUnchanged,true);assert.deepEqual(f,before);assert.equal(f.source.yearText,'');assert.equal(f.source.activity.startDate,'');assert(!('links' in out));assert(!('sourceUniqueIds' in out));
+});
+const changes:Record<string,(f:ReturnType<typeof fixture>)=>void>={
+ 'changed website body':f=>{f.websites[0].data.body+='changed';},
+ 'changed raw HTTP body':f=>{f.websites[0].data.httpBody+='changed';},
+ 'unrelated derived text paired with valid HTTP body':f=>{const site=f.websites[0].data;site.httpBody='Unrelated valid HTTP body';site.httpBodySha256=sha(site.httpBody);f.receipts[0].website.httpBodySha256=site.httpBodySha256;},
+ 'changed body with recomputed hash':f=>{f.websites[0].data.body+='changed';f.websites[0].data.bodySha256=sha(f.websites[0].data.body);},
+ 'wrong year':f=>{f.receipts[0].website.header.year=2025;},
+ 'wrong header date':f=>{f.receipts[0].website.header.dateText='October 18, 2026';},
+ 'header slot drift':f=>{f.receipts[0].website.header.start++;},
+ 'gallery fingerprint drift':f=>{f.context.sourceFingerprint=sha('reordered gallery');},
+ 'source caption drift':f=>{f.source.source.text+='changed';},
+ 'canonical clock drift':f=>{f.candidates[0].data.startTime='16:00';},
+ 'canonical version drift':f=>{f.candidates[0].version={seconds:100,nanoseconds:16};},
+ 'different slot':f=>{f.source.activity.startTime='16:00';},
+ 'missing child':f=>{f.candidates=[];},
+ 'duplicate candidate':f=>{f.candidates=[...f.candidates,{...structuredClone(f.candidates[0]),path:'venues/venue_fixture/events/duplicate_fixture'}];},
+ 'same title different clock':f=>{f.candidates=[...f.candidates,{...structuredClone(f.candidates[0]),path:'venues/venue_fixture/events/other_slot',data:{...f.candidates[0].data,startTime:'18:00'}}];},
+ 'disabled receipt':f=>{f.receipts[0].enabled=false;},
+ 'disabled child':f=>{f.candidates[0].data.disabled=true;},
+ 'expired child':f=>{f.candidates[0].data.expired=true;},
+ 'recurring child':f=>{f.candidates[0].data.isRecurring='Yes';},
+ 'manual suppression':f=>{f.suppressedEventIds=['child_fixture'];},
+ 'removed current membership':f=>{f.umbrella.data.programmeData.linkedEventIds=[];},
+ 'removed manual membership':f=>{f.review.data.finalization.manual.programmeData.linkedEventIds=[];},
+ 'manual item hold':f=>{f.review.data.heldItems.push({name:'Photo Booth'});},
+ 'negative verifier':f=>{f.context.verifierAccepted=false;},
+ 'changed activity receipt':f=>{f.context.activityFingerprint=sha('changed');},
+ 'duplicate receipt':f=>{f.receipts=[...f.receipts,...f.receipts];},
+ 'historical expired occurrence':f=>{f.asOf='2026-10-18';},
+ 'wrong official URL':f=>{f.websites[0].data.url='https://other.example/harvest';},
+ 'reordered programme':f=>{f.receipts[0].website.rows.push(f.receipts[0].website.rows[0]);},
+ 'unprinted source end clock':f=>{f.source.timeText='3 PM';},
+ 'invalid asOf':f=>{f.asOf='2026-99-99';},
+ 'explicit conflicting printed date with blank normalized date':f=>{f.source.dateText='October 18';f.receipts[0].evidenceFingerprint=fp(f.source);},
+ 'explicit conflicting printed edition':f=>{f.source.festivalNameText='Another Festival';f.receipts[0].evidenceFingerprint=fp(f.source);},
+ 'explicit conflicting printed weekday':f=>{f.source.dateText='Sunday October 17';f.receipts[0].evidenceFingerprint=fp(f.source);},
+ 'website header names another festival':f=>{const h=f.receipts[0].website.header;h.text=h.text.replace('Harvest Fest','Another Fest');const site=f.websites[0].data;site.body=h.text+' '+f.receipts[0].website.rows[0].text;h.end=h.text.length;f.receipts[0].website.rows[0].start=h.end+1;f.receipts[0].website.rows[0].end=site.body.length;site.bodySha256=sha(site.body);site.httpBody=site.body;site.httpBodySha256=sha(site.body);f.receipts[0].website.bodySha256=site.bodySha256;f.receipts[0].website.httpBodySha256=site.httpBodySha256;},
+};
+for(const [name,change] of Object.entries(changes))test(name+' fails closed without ordinary fallback',()=>{const f=fixture();change(f);assert.equal(reviewedFestivalCorroboration(f)?.reason,'invalid_reviewed_corroboration');});
+test('missing receipt leaves ordinary strict resolver in charge',()=>{const f=fixture();f.receipts=[];assert.equal(reviewedFestivalCorroboration(f),undefined);});
+test('exact umbrella self-reference is neither unrelated nor a programme child',()=>{
+ const f=fixture(),r=f.receipts[0];f.source.activity={name:'Harvest Fest',venueId:'venue_fixture',startDate:'2026-10-17',startTime:'15:00'};f.source.eventText='Harvest Fest';f.source.timeText='3:00 pm';r.kind='reviewed_umbrella_self_reference';r.evidenceFingerprint=fp(f.source);r.rowIndex=-1;r.canonical={...r.canonical,...r.umbrella,name:'Harvest Fest',startTime:'15:00',endTime:'20:00'};
