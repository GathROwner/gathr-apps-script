+
+export function bindFestivalSharedCaptionScope<T extends Item>(item:T,documents:readonly FestivalEvidenceDocument[]):T&{sharedCaptionScope?:FestivalSharedCaptionScope}{
+  const captions=documents.filter(d=>d.index===-1);
+  if(captions.length!==1||!item.sourceIndices?.includes(-1)||!item.venueText||!item.eventText||!item.timeText)return item;
+  const caption=captions[0].text,heading=caption.split(/\r?\n/)[0];
+  if(!item.membershipText||!item.festivalNameText||!heading.includes(item.membershipText)||!heading.includes(item.festivalNameText)||
+      (heading.match(/\b(?:fest|festival)\b/ig)||[]).length!==1||
+      /\b(?:last year|previous|formerly|past appearance|performed at|played at)\b/i.test(caption)||
+      count(caption,item.venueText)!==1||!new RegExp(`\\bat\\s+(?:the\\s+)?${escape(item.venueText)}(?=[\\s!.,;:]|$)`,'i').test(caption)||
+      (caption.match(/\bat\s+(?:the\s+)?[A-ZÀ-Ÿ]/g)||[]).length!==1)return item;
+  const dateMatches=caption.match(dates)||[];
+  if(dateMatches.length>1||item.dateText&&(!caption.includes(item.dateText)||count(caption,item.dateText)!==1))return item;
+  // Only a title/clock card may inherit context. A printed location or extra
+  // section is independent evidence and must not be overridden by a caption.
+  const remainder=item.scopeText.replace(item.eventText,'').replace(item.timeText,'');
+  if(!/^[\s|:\-–—()]*$/.test(remainder)||/\bat\s+[A-ZÀ-Ÿ]/.test(item.scopeText)&&!item.scopeText.includes(item.venueText))return item;
+  const rows=documents.filter(d=>item.sourceIndices!.includes(d.index)&&count(d.text,item.scopeText)===1&&
+      item.scopeText.includes(item.eventText)&&item.scopeText.includes(item.timeText));
+  if(rows.length!==1)return item;
+  const row=rows[0],start=row.text.indexOf(item.scopeText);
+  // A selected image cannot borrow a title or a clock from another image.
+  if(row.index>=0&&(item.sourceIndices!.filter(i=>i>=0).length!==1))return item;
+  const proof:FestivalSharedCaptionScope={version:1,rowDocumentIndex:row.index,rowStart:start,rowEnd:start+item.scopeText.length,captionStart:0,captionEnd:caption.length};
+  return {...item,sharedCaptionScope:proof};
+}
+
+export function validFestivalSharedCaptionScope(item:Item&{sharedCaptionScope:FestivalSharedCaptionScope},documents:readonly FestivalEvidenceDocument[]):boolean{
+  const derived=bindFestivalSharedCaptionScope({...item,sourceIndices:[...new Set([-1,item.sharedCaptionScope.rowDocumentIndex])]},documents).sharedCaptionScope;
+  return Boolean(derived&&JSON.stringify(derived)===JSON.stringify(item.sharedCaptionScope));
+}
