@@ -0,0 +1,24 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {validateFestivalEvidenceCapture} from './festival-evidence-extractor.mjs';
+const caption='Harvest Fest is TOMORROW!\nRain or shine, join us at Founders’!\nSaturday, October 17 | 3–8 PM';
+const row='PHOTO BOOTH\n3-7 PM';
+const input={caption,imageUrls:['https://example.test/card']};
+const fixture=()=>({complete:true,limitations:[],documents:[{index:-1,text:caption},{index:0,text:row}],activities:[{
+ kind:'festival_activity',sourceIndices:[-1,0],scopeText:row,membershipText:'Harvest Fest is TOMORROW!',festivalNameText:'Harvest Fest',yearText:'',organizerText:'',ticketUrl:'',
+ name:'PHOTO BOOTH',eventText:'PHOTO BOOTH',dateText:'Saturday, October 17',timeText:'3-7 PM',venueText:'Founders’',modelVerification:{accepted:true,reason:'Original caption and card'},verification:{accepted:false,reason:'cross_card_excerpt'}}]});
+test('literal shared caption venue/date bind without changing the row or inventing an edition',()=>{
+ const x=fixture(),result=validateFestivalEvidenceCapture(x,input),a=result.activities[0];
+ assert(a.sharedCaptionScope);assert(a.verification.accepted);assert.equal(a.scopeText,row);assert.equal(a.yearText,'');assert.equal(x.activities[0].verification.accepted,false);
+});
+test('ambiguous dates/venues, borrowed clocks and unscoped images remain held',()=>{
+ for(const suffix of ['\nSunday, October 18','\nAlso at Other Hall!','\nLast year we performed at Founders’']){
+  const x=fixture();x.documents[0].text+=suffix;assert(!validateFestivalEvidenceCapture(x,{...input,caption:x.documents[0].text}).activities[0].verification.accepted);
+ }
+ const x=fixture();x.activities[0].timeText='6-8 PM';assert(!validateFestivalEvidenceCapture(x,input).activities[0].verification.accepted);
+ const other=fixture();other.documents[1].text+='\nLocation: Other Hall';other.activities[0].scopeText=other.documents[1].text;
+ assert(!validateFestivalEvidenceCapture(other,input).activities[0].verification.accepted);
+ const y=fixture();y.activities[0].sourceIndices=[0];assert.throws(()=>validateFestivalEvidenceCapture(y,input),/invented_activity_scope/);
+});
+test('an independent negative verification is never turned into a positive',()=>{
+ const x=fixture();x.activities[0].modelVerification.accepted=false;assert(!validateFestivalEvidenceCapture(x,input).activities[0].verification.accepted);
+});
