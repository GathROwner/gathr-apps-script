{
  "functions": [
    {
      "source": "social-staging",
      "codebase": "gathr-social",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run prepare-deploy"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.social-production.rules",
    "indexes": "firestore.social-production.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
