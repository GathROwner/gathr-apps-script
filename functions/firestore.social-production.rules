rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is accessing their own document
    function isAccessingOwnData(userId) {
      return request.auth.uid == userId;
    }

    // Check if user is an admin (via custom claims)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function requestOwnerMatches(userId) {
      return request.resource.data.ownerUid == userId;
    }

    function resourceOwnerMatches(userId) {
      return resource.data.ownerUid == userId;
    }

    function protectedSocialProfileFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'socialHandle',
        'socialHandleNormalized',
        'socialHandleUpdatedAt'
      ]);
    }

    // =========================================================================
    // EXISTING APP COLLECTIONS
    // =========================================================================

    // Users retain their existing self-service access, except social identity
    // fields and social projections are controlled by Cloud Functions.
    match /users/{userId} {
      allow read: if isAuthenticated() && isAccessingOwnData(userId);
      allow create: if isAuthenticated() && isAccessingOwnData(userId) &&
        !request.resource.data.keys().hasAny([
          'socialHandle',
          'socialHandleNormalized',
          'socialHandleUpdatedAt'
        ]);
      allow update: if isAuthenticated() && isAccessingOwnData(userId) &&
        !protectedSocialProfileFieldsChanged();
      allow delete: if isAuthenticated() && isAccessingOwnData(userId);

      match /friends/{friendUid} {
        allow read: if isAuthenticated() && isAccessingOwnData(userId);
        allow write: if false;
      }

      match /friendRequests/{otherUid} {
        allow read: if isAuthenticated() && isAccessingOwnData(userId);
        allow write: if false;
      }

      match /friendActivity/{ownerUid} {
        allow read: if isAuthenticated() && isAccessingOwnData(userId);
        allow write: if false;
      }

      match /friendEvents/{eventId} {
        allow read: if isAuthenticated() && isAccessingOwnData(userId);
        allow write: if false;
      }

      match /friendEventLocations/{eventId} {
        allow read: if isAuthenticated() && isAccessingOwnData(userId);
        allow write: if false;
      }

      match /blocks/{blockedUid} {
        allow read: if isAuthenticated() && isAccessingOwnData(userId);
        allow write: if false;
      }

      // User-private shared event records. Do not name this subcollection
      // "events"; collection-group events are publicly readable below.
      match /privateSharedEvents/{eventId} {
        allow read: if isAuthenticated() && isAccessingOwnData(userId) && resourceOwnerMatches(userId);
        allow create, update: if isAuthenticated() && isAccessingOwnData(userId) && requestOwnerMatches(userId);
        allow delete: if isAuthenticated() && isAccessingOwnData(userId) && resourceOwnerMatches(userId);
      }

      // Raw share ingest/status records are written by Cloud Functions admin SDK.
      match /sharedEventIngests/{ingestId} {
        allow read: if isAuthenticated() && isAccessingOwnData(userId) && resourceOwnerMatches(userId);
        allow write: if false;
      }

      // Server-owned anti-abuse counters. Clients cannot inspect or alter them.
      match /crowdContributionDays/{dayId} {
        allow read, write: if false;
      }
    }

    // Contains private contributor references and consensus audit state. Only
    // Cloud Functions admin SDK code may access this collection.
    match /crowdsourced_shared_event_candidates/{aggregateId} {
      allow read, write: if false;
    }

    // Canonical social state and abuse controls are written by Admin SDK only.
    match /socialHandles/{handle} {
      allow read, write: if false;
    }

    match /socialRelationships/{relationshipId} {
      allow read, write: if false;
    }

    match /activeCheckIns/{ownerUid} {
      allow read: if isAuthenticated() && isAccessingOwnData(ownerUid);
      allow write: if false;
    }

    match /checkInEligibilitySessions/{sessionId} {
      allow read, write: if false;
    }

    match /checkInPlaceCandidates/{candidateId} {
      allow read, write: if false;
    }

    match /friendEvents/{eventId} {
      allow read, write: if false;
    }

    match /friendEventPrivateLocations/{eventId} {
      allow read, write: if false;
    }

    match /friendEventInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /friendEventResponses/{responseId} {
      allow read, write: if false;
    }

    match /socialRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /socialOperations/{operationId} {
      allow read, write: if false;
    }

    match /userReports/{reportId} {
      allow read, write: if false;
    }

    // Interests collection - authenticated users can read, but not modify
    match /interests/{interestId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Page submissions collection - authenticated users can create and read
    match /pageSubmissions/{submissionId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    // Event likes collection - authenticated users can read/write
    match /eventLikes/{eventId} {
      allow read, write: if isAuthenticated();
    }

    // Event shares collection
    match /eventShares/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.count is number
                    && request.resource.data.count >= 0;
      allow update: if isAuthenticated()
                    && request.resource.data.count is number
                    && request.resource.data.count > resource.data.count;
    }

    // Event users responded collection
    match /eventUsersResponded/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // NEW: VENUES COLLECTION (Phase 1 Migration)
    // Public read access for guest users (unauthenticated)
    // Write access restricted to admin users only
    // =========================================================================
    match /venues/{venueId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Events subcollection (nested under venues)
      match /events/{eventId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // Collection group query for events (cross-venue queries)
    match /{path=**}/events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // NEW: PROCESSING COLLECTIONS (Admin only)
    // =========================================================================

    // Tracks processed Apify export files
    match /processed_datasets/{datasetId} {
      allow read, write: if isAdmin();
    }

    // Venues that couldn't be matched during processing
    match /unrecognized_venues/{venueId} {
      allow read, write: if isAdmin();
    }

    // State for resumable batch processing
    match /processing_state/{stateId} {
      allow read, write: if isAdmin();
    }

    // Verified public-source candidates from user shares. Admin validation must
    // promote these before they can enter public event collections.
    match /public_shared_event_candidates/{candidateId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // ADMINS COLLECTION (optional - for Firestore-based admin management)
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }

    // =========================================================================
    // DEFAULT: Deny all other access
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
