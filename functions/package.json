{
  "name": "gathr-functions",
  "version": "1.0.0",
  "description": "GathR Cloud Functions for data processing pipeline",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only auth,firestore,functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:social-staging": "firebase deploy --project gathr-social-staging --config firebase.staging.json --only functions",
    "test:compiled": "npm run build && node --test lib/**/*.test.js",
    "test:social": "npm run build && node --test lib/social/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-gathr-social --only firestore \"node --test test/firestore-social.rules.test.mjs\"",
    "test:social-integration": "npm run build && firebase emulators:exec --project demo-gathr-social --only firestore \"node --test --test-concurrency=1 test/social-service.integration.test.mjs test/friend-events.integration.test.mjs\"",
    "test:social-callables": "npm run build && node scripts/prepare-social-staging-deploy.mjs && cross-env FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase --config firebase.social-production.json emulators:exec --project demo-gathr-social --only \"auth,firestore,functions\" \"node --test test/social-callables.e2e.test.mjs\"",
    "test:social-staging": "node scripts/test-social-staging.e2e.mjs",
    "staging:seed-social-venues": "node scripts/seed-social-staging-venues.mjs",
    "staging:seed-social-personas": "node scripts/seed-social-staging-personas.mjs",
    "social:personas": "node test/social-emulator-personas.mjs",
    "social:prepare-local-secret": "node scripts/prepare-local-social-secret.mjs",
    "test:all": "npm run test:compiled && npm run test:rules && npm run test:social-integration",
    "verify:parser-env": "node scripts/verify-parser-env.mjs",
    "logs": "firebase functions:log",
    "lint": "eslint src/**/*.ts",
    "lint:social": "eslint src/social/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^144.0.0",
    "luxon": "^3.5.0",
    "openai": "^4.76.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "firebase-functions-test": "^3.4.0",
    "firebase-tools": "^14.17.0",
    "typescript": "^5.7.0"
  },
  "private": true
}
